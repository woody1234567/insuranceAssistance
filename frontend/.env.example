# ==========================================
# 前端環境變數範本 (Frontend Environment Variables Example)
# 請複製此檔案為 .env 並依需求調整各設定值：
#   cp .env.example .env
# ==========================================

# 後端 API 基礎路徑
# - 本地開發（搭配 Vite proxy）：建議使用 "/api/v1"
# - 線上部署或獨立網域：可填入完整後端 API URL，如 "https://insurancebackend.zeabur.app/api/v1"
VITE_API_BASE_URL=/api/v1

# 本地開發時 Vite Proxy 轉發的後端伺服器目標位址
# - 連線遠端測試機：https://insurancebackend.zeabur.app
# - 本地後端開發：http://localhost:3000
VITE_API_PROXY_TARGET=https://insurancebackend.zeabur.app

# 模擬登入使用者 ID (透過 x-user-id Header 傳入)
# 目前尚未實作完整登入系統，預設為資料庫中的種子測試使用者 UUID
VITE_USER_ID=00000000-0000-0000-0000-000000000001

# 本地開發伺服器 Port (選用，預設 5173)
VITE_PORT=5173
