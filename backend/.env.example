# Database Connection: Use DATABASE_URL for local dev or DB_SOCKET_PATH for GCP Cloud Run with Cloud SQL
# DATABASE_URL=mysql://user:password@localhost:3306/insurance_assistance
DB_SOCKET_PATH=/cloudsql/your-project:asia-east1:your-db-instance
DB_USER=app_backend
DB_PASSWORD=your-db-password
DB_NAME=insurance_db
# DB_HOST=localhost
# DB_PORT=3306

PORT=3000
# Comma-separated list of allowed origins or "*"
CORS_ORIGIN=http://localhost:5173

# AI Provider: "google-vertex" (recommended for GCP / production) or "google" (Google AI Studio API key)
AI_PROVIDER=google-vertex
AI_MODEL=gemini-2.0-flash

# Google Cloud Vertex AI settings (AI_PROVIDER=google-vertex)
GOOGLE_VERTEX_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=asia-east1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google AI Studio API Key (used when AI_PROVIDER=google)
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
